# ==============================================================================
# FinAI Track — .gitignore (Monorepo: FastAPI + Next.js + Flutter)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 2. Python & FastAPI Backend
# ------------------------------------------------------------------------------
# Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing, Quality & Coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.tox/

# ------------------------------------------------------------------------------
# 3. Node.js & Next.js Frontend
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.pnp
.pnp.js

# Next.js Build Output & Cache
.next/
*/.next/
out/
*/out/
.turbo/
*/.turbo/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Flutter / Mobile (Fase 2 & 3)
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.apk
*.aab
*.ipa

# ------------------------------------------------------------------------------
# 5. Database, Local Volumes & Media Temp Uploads
# ------------------------------------------------------------------------------
*.sqlite3
*.db
*.sql
*.dump
postgres_data/
redis_data/

# Temporary Audio / Upload Files
uploads/
temp/
tmp/
*.webm
*.ogg
*.wav
*.m4a

# ------------------------------------------------------------------------------
# 6. Operating System & IDE
# ------------------------------------------------------------------------------
# OS Artifacts
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
