# ==============================================================================
# FinAI Track — Environment Variables Template
# ==============================================================================

# Application Environment
ENV=development
DEBUG=True
API_PORT=8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=change_me_to_a_secure_random_key_min_32_chars

# Database: PostgreSQL
POSTGRES_USER=finai_user
POSTGRES_PASSWORD=finai_secret_password
POSTGRES_DB=KRSI-FinAI
POSTGRES_PORT=5432
# Format untuk asyncpg: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://finai_user:finai_secret_password@localhost:5432/KRSI-FinAI

# Cache & Message Broker: Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Authentication & JWT
JWT_SECRET_KEY=change_me_to_a_very_secure_jwt_secret_key_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI & LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/webhook/telegram

